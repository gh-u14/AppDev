[BASIC]
init-hook='import sys, os; sys.path.append(os.path.join(os.path.dirname(__file__), "..") if "__file__" in globals() else ".")'
disable =
    missing-function-docstring,
    missing-module-docstring,
    missing-class-docstring,
    too-few-public-methods,
    not-callable,
    attribute-defined-outside-init,
    ungrouped-imports,
    wrong-import-order,
    duplicate-code,
    unused-import,
    too-many-arguments,
    unused-argument,
    import-outside-toplevel,
    too-many-instance-attributes,
    import-error

ignore-paths =
    deploy,
    temp,
    build,
    tests,
    migrations

extension-pkg-whitelist=
    pydantic,
    orjson

generated-members =
    [pydantic.PostgresDsn.build]

